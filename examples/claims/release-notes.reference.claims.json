      ],
      "when": null,
      "check": {
        "type": "tool",
        "tools": [
          "Bash"
        ],
        "input_any": [
          "git\\s+(log|rev-list|shortlog)\\b[^\"]*\\S+\\.\\.(HEAD|\\s|\")",
          "git\\s+(log|rev-list|shortlog)\\b[^\"]*\\$\\(git\\s+describe"
        ],
        "output_any": []
      },
      "node": "commits"
    },
    {
