      "check": {
        "type": "judge",
        "question": "Does the agent's final answer tell the user that there are no commits since the latest tag and therefore nothing to release?"
      },
      "node": "nothing"
    },
    {
      "id": "major",
      "kind": "step",
      "text": "Bump the major version",
      "span": [
        10,
        10
      ],
