      "node": "migration",
      "when_all": [
        {
          "cond": "any=yes",
          "value": true
        },
        {
          "cond": "breaking=yes",
          "value": true
        }
      ]
    },
    {
      "id": "group",
      "kind": "step",
      "text": "Group commits into Features, Bug fixes, and Other, leaving out chore: commits",
      "span": [
        12,
        12
      ],
      "after": [
        "migration",
        "minor",
        "patch"
      ],
      "when": {
        "cond": "any=yes",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Are the commits in RELEASE_NOTES.md grouped under Features, Bug fixes, and Other sections (sections may be omitted if empty), with all chore: commits left out?"
