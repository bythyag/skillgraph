      "node": "patch",
      "when_all": [
        {
          "cond": "any=yes",
          "value": true
        },
        {
          "cond": "breaking=no",
          "value": true
        },
        {
          "cond": "feat=no",
          "value": true
        }
      ]
    },
    {
      "id": "migration",
      "kind": "step",
      "text": "Put a Breaking changes section first, with migration notes for users",
      "span": [
        11,
        11
      ],
      "after": [
        "major"
      ],
      "when": {
        "cond": "breaking=yes",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Does RELEASE_NOTES.md have a Breaking changes section placed before all other change sections, containing migration notes that tell users what they need to change?"
