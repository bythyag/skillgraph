      "when": {
        "cond": "any=yes",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Does each commit entry in RELEASE_NOTES.md credit that commit's author?"
      },
      "node": "credit"
    },
    {
      "id": "write",
      "kind": "step",
      "text": "Write RELEASE_NOTES.md headed with the new version",
