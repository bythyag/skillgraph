      "when": {
        "cond": "breaking=yes",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Did the agent bump the major version relative to the latest release tag (e.g. 1.4.2 -> 2.0.0), resetting minor and patch to zero?"
