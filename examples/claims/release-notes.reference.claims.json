      "node": "minor",
      "when_all": [
        {
          "cond": "any=yes",
          "value": true
        },
        {
          "cond": "breaking=no",
          "value": true
        },
        {
          "cond": "feat=yes",
          "value": true
        }
      ]
    },
    {
      "id": "patch",
      "kind": "step",
      "text": "Bump the patch version",
      "span": [
        20,
        20
      ],
      "after": [
        "commits"
      ],
      "when": {
        "cond": "feat=no",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Did the agent bump only the patch version relative to the latest release tag (e.g. 1.4.2 -> 1.4.3)?"
