    {
      "id": "rule-link-every-entry-to",
      "kind": "artifact",
      "text": "Link every entry to its commit hash.",
      "span": [
        22,
        22
      ],
      "after": [],
      "when": null,
      "check": {
        "type": "judge",
        "question": "Does every commit entry in RELEASE_NOTES.md include or link to that commit's hash?"
      },
      "node": "rule-link-every-entry-to"
