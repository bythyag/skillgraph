  "claims": [
    {
      "id": "tag",
      "kind": "step",
      "text": "Find the latest release tag",
      "span": [
        1,
        1
      ],
      "after": [],
      "when": null,
      "check": {
        "type": "tool",
        "tools": [
          "Bash"
        ],
        "input_any": [
          "git\\s+describe\\b[^\\\"]*--tags",
          "git\\s+tag\\b(?!\\s+(-a|-s|-f|-m|-d|v?\\d))",
          "git\\s+for-each-ref\\b[^\\\"]*refs/tags",
          "git\\s+log\\b[^\\\"]*--decorate"
        ],
        "output_any": []
      },
      "node": "tag"
    },
    {
      "id": "commits",
      "kind": "step",
      "text": "List the commits since that tag",
      "span": [
        2,
        2
      ],
      "after": [
