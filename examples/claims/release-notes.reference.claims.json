    {
      "id": "rule-never-create-git-tags",
      "kind": "must_not",
      "text": "Never create git tags or push; release managers publish the release.",
      "span": [
        21,
        21
      ],
      "after": [],
      "when": null,
      "check": {
        "type": "tool",
        "tools": [
          "Bash"
        ],
        "input_any": [
          "git\\s+(-C\\s+\\S+\\s+)?push\\b",
          "git\\s+(-C\\s+\\S+\\s+)?tag\\s+(-[asfmu]\\b|--annotate|--sign|--force|[^-\\s|;&>\"])"
        ],
        "output_any": []
      },
      "node": "rule-never-create-git-tags"
