      "node": "major",
      "when_all": [
        {
          "cond": "any=yes",
          "value": true
        },
        {
          "cond": "breaking=yes",
          "value": true
        }
      ]
    },
    {
      "id": "minor",
      "kind": "step",
      "text": "Bump the minor version",
      "span": [
        19,
        19
      ],
      "after": [
        "commits"
      ],
      "when": {
        "cond": "feat=yes",
        "value": true
      },
      "check": {
        "type": "judge",
        "question": "Did the agent bump the minor version relative to the latest release tag (e.g. 1.4.2 -> 1.5.0), keeping the major version and resetting patch to zero?"
