{
  "color": {
    "$type": "color",
    "$description": "Semantic color roles, dark mapping. Names never change across modes; only values do. Dark is a separate mapping, never an inversion (DC-L01-18).",
    "$extensions": {
      "opendesigner": {
        "mode": "dark",
        "evidence": [
          "DC-L01-11",
          "DC-L01-12",
          "DC-L01-17",
          "DC-L01-18",
          "DC-L01-19",
          "DC-L04-12",
          "DC-L04-13"
        ]
      }
    },
    "surface": {
      "sunken": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Wells, code blocks, page gutters."
      },
      "base": {
        "$value": "{color.neutral.dark.2}",
        "$description": "The page background."
      },
      "raised": {
        "$value": "{color.neutral.dark.3}",
        "$description": "Cards and panels on the page."
      },
      "overlay": {
        "$value": "{color.neutral.dark.4}",
        "$description": "Menus, popovers, dialogs; always with elevation.floating or elevation.overlay."
      },
      "nav": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Recessive navigation, dimmer than content (Linear 2026, S-L06-067)."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.dark.12}",
        "$description": "Body copy, headings, labels (guaranteed >= 7:1 on steps 1-5)."
      },
      "secondary": {
        "$value": "{color.neutral.dark.11}",
        "$description": "Supporting text (guaranteed >= the text minimum on surfaces and neutral fills 1-4)."
      },
      "tertiary": {
        "$value": "{color.neutral.dark.10}",
        "$description": "Captions and placeholders (still meets the text minimum on surfaces 1-4)."
      },
      "disabled": {
        "$value": "{color.neutral.dark.8}",
        "$description": "Disabled labels; exempt from contrast minimums (WCAG 1.4.3 exception)."
      },
      "inverse": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on color.bg.inverse (tooltips, toasts)."
      },
      "link": {
        "$value": "{color.accent.dark.11}",
        "$description": "Links. Underline them in running text so color is not the only cue."
      },
      "accent": {
        "$value": "{color.accent.dark.11}",
        "$description": "Accent text and selected labels."
      },
      "on-accent": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text and icons on color.bg.accent.bold* (auto-picked light or dark, S-L06-094)."
      },
      "on-action": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on the primary action fill."
      },
      "on-brand": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on color.bg.brand."
      },
      "success": {
        "$value": "{color.success.dark.11}",
        "$description": "Success text and icons; pair with an icon or label (DC-L01-15)."
      },
      "on-success": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on bg.success.bold."
      },
      "warning": {
        "$value": "{color.warning.dark.11}",
        "$description": "Warning text and icons; pair with an icon or label (DC-L01-15)."
      },
      "on-warning": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on bg.warning.bold."
      },
      "danger": {
        "$value": "{color.danger.dark.11}",
        "$description": "Danger text and icons; pair with an icon or label (DC-L01-15)."
      },
      "on-danger": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on bg.danger.bold."
      },
      "info": {
        "$value": "{color.info.dark.11}",
        "$description": "Info text and icons; pair with an icon or label (DC-L01-15)."
      },
      "on-info": {
        "$value": "{color.neutral.dark.1}",
        "$description": "Text on bg.info.bold."
      }
    },
