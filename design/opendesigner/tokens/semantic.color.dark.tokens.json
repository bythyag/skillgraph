        "$description": "Selected card or accent outline."
      },
      "separator": {
        "$value": "{color.neutral.dark.5}",
        "$description": "Hairlines between table rows and list items, lighter than border.subtle; decorative, so never the only cue (DC-L23-05)."
      },
      "success": {
        "$value": "{color.success.dark.8}",
        "$description": "Success boundary, for example an invalid field (3:1)."
      },
      "warning": {
        "$value": "{color.warning.dark.8}",
