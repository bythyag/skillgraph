      },
      "strong": {
        "$value": "{color.neutral.dark.8}",
        "$description": "Boundaries that are the only cue: inputs, checkboxes, switches (3:1, WCAG 1.4.11)."
      },
      "input": {
        "$value": "{color.neutral.dark.8}",
        "$description": "Text field and select borders (3:1, DC-L01-16)."
      },
